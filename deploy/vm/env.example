# Copy to .env on the VM. Values never leave the VM (SECRETS.md rules apply).
POSTGRES_PASSWORD=
TUNNEL_TOKEN=
# M5.7 live ingest: set QR500_INGEST=databento and the API key to settle live
QR500_INGEST=off
DATABENTO_API_KEY=
# umami session-signing secret; deploy.sh generates it if left empty
UMAMI_APP_SECRET=
