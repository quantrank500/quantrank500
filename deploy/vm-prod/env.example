# Copy to .env on the prod VM. Values never leave the VM (SECRETS.md rules).
POSTGRES_PASSWORD=
# empty until launch day — dark prod runs with no ingress
TUNNEL_TOKEN=
# live ingest: set QR500_INGEST=databento and the API key to settle live
QR500_INGEST=off
DATABENTO_API_KEY=
# umami session-signing secret; deploy.sh generates it if left empty
UMAMI_APP_SECRET=
